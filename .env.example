# ================================================================
# BStore — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais.
# NUNCA comitar o ficheiro .env para o repositório.
# ================================================================

# ---------------------------------------------------------------
# BASE DE DADOS — Supabase (PostgreSQL)
# ---------------------------------------------------------------

# 1. Ligação de Migrações (Flyway — papel dono da BD, direct connection / porta 5432)
# Formato: postgresql://postgres:[SUA_PASSWORD]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres
MIGRATION_DB_URL=postgresql://postgres:[SUA_PASSWORD]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=[SUA_PASSWORD]

# 2. Ligação da Aplicação (JPA — papel restrito bstore_app, transaction pooler / porta 6543)
# Formato: postgresql://bstore_app:[SENHA_BSTORE_APP]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DATABASE_URL=postgresql://bstore_app:[SENHA_BSTORE_APP]@[SEU_POOLER_HOST]:6543/postgres?sslmode=require&prepareThreshold=0
DB_USER=bstore_app
DB_PASSWORD=[SENHA_BSTORE_APP]

# Limites do Pool de Ligações (HikariCP) — conservador para respeitar limites do Supabase
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ---------------------------------------------------------------
# FUSO HORÁRIO
# ---------------------------------------------------------------
APP_TIMEZONE=Africa/Maputo

# ---------------------------------------------------------------
# AUTENTICAÇÃO & SERVIDOR
# ---------------------------------------------------------------

# Porta do servidor (Railway / Render define PORT automaticamente)
PORT=8080

# Superuser inicial (usado apenas na primeira execução, quando a BD está vazia)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=password_segura_min8chars
ADMIN_NOME=Administrador

# ---------------------------------------------------------------
# CORS (opcional — para desenvolvimento com frontend separado)
# ---------------------------------------------------------------

# Origem permitida para pedidos cross-origin (ex: http://localhost:5173)
# Em produção, a aplicação React é servida pelo mesmo servidor, então não é necessário.
CORS_ALLOWED_ORIGIN=

# ---------------------------------------------------------------
# COOKIES DE SESSÃO
# ---------------------------------------------------------------

# Definir como "true" em produção (HTTPS obrigatório) para o flag Secure e SameSite nos cookies.
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------
# NOTIFICAÇÕES WHATSAPP (Z-API)
# ---------------------------------------------------------------
# Notificações imediatas para o dono:
# 1. Venda registada (total, itens, método de pagamento, troco)
# 2. Adição de novo produto (preço, custo, estoque inicial)
# 3. Alertas críticos de baixo estoque
# 4. Abertura de sessão de caixa (fundo de abertura)
# 5. Fecho de sessão de caixa (esperado vs contado, diferença, vendas)

# Ativa/desativa envio automático de WhatsApp globalmente
ZAPI_NOTIFICACOES_ACTIVAS=true

# Número do dono/gerente com código do país (ex: 25884xxxxxxx para Moçambique ou 5511xxxxxxxxx para o Brasil)
ZAPI_DONO_TELEFONE=

# Credenciais da Instância Z-API (obtidas no painel da sua conta Z-API)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Client-Token (opcional, apenas caso ativado na segurança da instância Z-API)
ZAPI_CLIENT_TOKEN=

# ---------------------------------------------------------------
# NOTAS DE SEGURANÇA
# ---------------------------------------------------------------
#
# 1. Em produção no Railway:
#    - MIGRATION_DB_URL liga na porta 5432 como postgres para aplicar migrações.
#    - DATABASE_URL liga na porta 6543 como bstore_app com RLS estrito e prepareThreshold=0.
#    - Se MIGRATION_DB_URL não for definido, o sistema usa DATABASE_URL como fallback.
#
# 2. Criar a senha do papel bstore_app no SQL Editor do Supabase:
#    ALTER ROLE bstore_app WITH PASSWORD 'sua_senha_segura';
#
# 3. A chave "service_role" do Supabase NÃO deve ser usada aqui.
#    O backend Java usa JDBC direto com PostgreSQL.
#
