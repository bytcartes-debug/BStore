# ================================================================
# BStore — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais.
# NUNCA comitar o ficheiro .env para o repositório.
# ================================================================

# ---------------------------------------------------------------
# BASE DE DADOS — Supabase (PostgreSQL)
# ---------------------------------------------------------------

# URL de ligação directa ao Supabase (porta 5432 — necessária para Flyway e JPA).
# Formato: postgresql://[user]:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[SUA_PASSWORD]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres

# Utilizador da base de dados (extraído automaticamente da URL se não definido)
DB_USER=postgres

# Password da base de dados (extraída automaticamente da URL se não definido)
DB_PASSWORD=[SUA_PASSWORD]

# ---------------------------------------------------------------
# AUTENTICAÇÃO & SERVIDOR
# ---------------------------------------------------------------

# Porta do servidor (Render.com define PORT automaticamente)
PORT=8080

# Superuser inicial (usado apenas na primeira execução, quando a BD está vazia)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=password_segura_min8chars
ADMIN_NOME=Administrador

# ---------------------------------------------------------------
# CORS (opcional — para desenvolvimento com frontend separado)
# ---------------------------------------------------------------

# Origem permitida para pedidos cross-origin (ex: http://localhost:5173)
# Em produção, a aplicação React é servida pelo mesmo servidor, então não é necessário.
CORS_ALLOWED_ORIGIN=

# ---------------------------------------------------------------
# COOKIES DE SESSÃO
# ---------------------------------------------------------------

# Definir como "true" em produção (HTTPS obrigatório) para o flag Secure nos cookies.
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------
# NOTAS DE SEGURANÇA
# ---------------------------------------------------------------
#
# 1. Em produção no Render.com, definir todas estas variáveis
#    no painel: Dashboard → Service → Environment.
#
# 2. Para segurança máxima no Supabase, executar o script
#    supabase_setup.sql no SQL Editor do Supabase para criar
#    o role "bstore_app" com permissões limitadas.
#    Após isso, usar as credenciais do bstore_app aqui.
#
# 3. A chave "service_role" do Supabase NÃO deve ser usada aqui.
#    O backend Java usa JDBC directo, não a API do Supabase.
#
